class Solution:
    def mySqrt(self, x: int) -> int:
        # brute force TC = O(sqrt(N))
        # i=1
        # for i in range(x+1):  
        #     if i*i==x:
        #         return i
        #     elif i*i>x:
        #         return i-1          
        # return 1

        left=0
        right=x
        ans=0

        while left<=right:
            mid=(left+right)//2

            if mid*mid==x:
                return mid
            elif mid*mid<x:
                ans=mid
                left=mid+1
            else:
                right=mid-1
        return ans  
        # Binary Search  TC = O(logN)        


        
