class Solution:
    def mapWordWeights(self, words: List[str], weights: List[int]) -> str:
        res = []

        for word in words:
            s = 0
            for ch in word:
                s += weights[ord(ch) - ord('a')]

            s %= 26
            res.append(chr(ord('a') + (25 - s)))

        return "".join(res)
